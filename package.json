{
  "name": "cairn",
  "version": "0.1.0",
  "description": "Cairn — 工程组织的知识层与智能体平台",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter cairn-web dev",
    "mock:web": "pnpm --filter cairn-web mock",
    "test:web": "pnpm --filter cairn-web test",
