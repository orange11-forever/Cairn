    "build:web": "pnpm --filter cairn-web build",
    "verify:web": "pnpm --filter cairn-web verify",
    "test": "pnpm run test:web",
    "typecheck": "pnpm run typecheck:web",
    "build": "pnpm run build:web",
    "verify": "pnpm run verify:web"
  },
  "license": "ISC",
