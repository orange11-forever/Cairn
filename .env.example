# Cairn 环境变量示例
#
# 用法：复制成 .env 并填上你自己的值。
#   cp .env.example .env
#
# .env 不进仓库（见 .gitignore）。这个示例文件进仓库——
# 它的作用是让部署的人（你自己、或私有部署的客户）知道**有哪些东西可配**。
# 没有这份文件，部署者只能去读源码找环境变量，那是很差的交付体验。
#
# 命名规则：**只有 VITE_ 前缀的变量会被打进前端产物，等于公开。**
# 密钥类的东西绝不能加 VITE_ 前缀，必须由后端持有。

# ---------------------------------------------------------------------------
# 前端（构建时注入，改了要重新 build）
# ---------------------------------------------------------------------------

# 后端 API 的基地址。不填则用 http://localhost:8787（本地 mock 后端）。
#
# 部署时必填。不填的后果：客户的浏览器会去连他们自己的 localhost，
# 症状是"页面能打开但所有请求都失败"——而这个症状看起来像后端挂了。
#
#   本地开发    http://localhost:8787
#   同域部署    https://kb.example.com     （前后端在同一域名下，走反向代理分流）
#   跨域部署    https://api.example.com    （记得把前端域名加进后端 CORS 白名单）
VITE_API_URL=http://localhost:8787


# ---------------------------------------------------------------------------
# 后端（阶段 B 起用到，现在还没有后端，先把形状定下来）
# ---------------------------------------------------------------------------

# 应用对外的地址。用于：邮件里的链接、OAuth 回调、生成绝对 URL。
# 写死的后果：用户点邮件里的"重置密码"跳到了别人的域名。
# APP_URL=http://localhost:5500

# 允许跨域访问 API 的来源，逗号分隔。
# 不能用 * ——带 Cookie 的请求浏览器会拒绝通配符来源。
# CORS_ORIGINS=http://localhost:5500

# 登录 Cookie 的域。跨子域共享登录态时才需要设。
# COOKIE_DOMAIN=.example.com

# 数据库
# DATABASE_URL=postgresql://cairn:CHANGE_ME@localhost:5432/cairn

# Redis（任务队列）
# REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥。生产环境必须换成随机值：openssl rand -hex 32
# JWT_SECRET=CHANGE_ME_IN_PRODUCTION


# ---------------------------------------------------------------------------
# 模型 Provider（阶段 C 起用到）
#
# 设计目标：**任何一家都能接，包括自建中转站。**
# 支持 OpenAI、Anthropic、国产模型（DeepSeek / 通义 / 智谱 / Kimi）、
# 自建中转、以及客户内网自部署的模型（vLLM / Ollama）。
#
# 关键点：**光有 base_url 不够，还要 LLM_PROVIDER 指明协议类型。**
# 因为两大阵营的接口形状不同：
#
#   openai-compatible   POST {base}/chat/completions
#                       Authorization: Bearer <key>
#                       → OpenAI、DeepSeek、通义、智谱、Kimi、
#                         多数中转站、vLLM、Ollama、LM Studio
#
#   anthropic           POST {base}/messages
#                       x-api-key: <key>  +  anthropic-version 请求头
#                       请求体用 system 顶层字段而非 system role
#                       → Claude 官方 API
#
# 所以"改个 base_url 就能换 Claude"是不成立的——它需要另一个适配器。
# 但如果你的中转站把 Claude 包成了 OpenAI 兼容格式，那就用
# openai-compatible 类型即可（多数中转站都这么做）。
# ---------------------------------------------------------------------------

# ---- 生成模型 ----

# 协议类型：openai-compatible | anthropic
LLM_PROVIDER=openai-compatible

# 常见取值（选一组，取消注释）：
#
#   OpenAI 官方
#     LLM_PROVIDER=openai-compatible
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o
#
#   Claude 官方（注意 PROVIDER 不同）
#     LLM_PROVIDER=anthropic
#     LLM_BASE_URL=https://api.anthropic.com/v1
#     LLM_MODEL=claude-sonnet-4-5
#
#   DeepSeek（便宜，中文强）
#     LLM_BASE_URL=https://api.deepseek.com/v1
#     LLM_MODEL=deepseek-chat
#
#   通义千问（阿里云内网调用延迟极低）
#     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     LLM_MODEL=qwen-plus
#
#   自建中转站 / 第三方中转
#     LLM_BASE_URL=https://你的中转域名/v1
#     LLM_MODEL=（中转站支持的任意模型名）
#     ⚠️ 见下面「中转站的数据风险」
#
#   客户内网自部署（vLLM / Ollama，完全不出网）
#     LLM_BASE_URL=http://内网地址:8000/v1
#     LLM_MODEL=qwen2.5-72b-instruct
#     LLM_API_KEY=（本地部署通常不需要，填任意值）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=CHANGE_ME

# 单次请求超时（秒）。中转站通常比直连慢，酌情加大。
LLM_TIMEOUT_S=60

# 上下文窗口（token）。不同模型差异极大，用于上下文预算裁剪。
# 填小于模型实际上限的值——留出输出空间。
LLM_CONTEXT_WINDOW=64000


# ---- Embedding 模型（可以和生成模型不同家）----

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=CHANGE_ME

# ⚠️⚠️ 向量维度：**改这个值等于要重建整个向量库。**
#
# pgvector 的列类型是 vector(N)，N 是建表时写死的。不同模型维度不同：
#   OpenAI text-embedding-3-small   1536
#   OpenAI text-embedding-3-large   3072
#   通义 text-embedding-v3          1024
#   BGE-M3                          1024
#
# 换 embedding 模型意味着：改列定义 + 重新算所有历史文档的向量。
# 一个十万 chunk 的库要重跑几小时并重新付一次 embedding 费用。
#
# 所以这个值在阶段 C 建表时就要定，且**必须和数据库列的维度一致**。
# 启动时要校验两者相等，不一致就拒绝启动——不校验的后果是
# 入库时才报维度错误，而那时用户已经上传了文件。
EMBEDDING_DIM=1024

# 批量大小。多数接口单次上限 25-100 条，中转站可能更小。
EMBEDDING_BATCH_SIZE=25


# ---------------------------------------------------------------------------
# ⚠️ 中转站的数据风险（必须让部署者知道）
#
# 中转站会看到**全部 prompt 内容**，也就是你的知识库原文。
# 而这个产品的定位是企业知识库——那些文档往往是全公司最敏感的资料。
#
# 所以：
#   开发和演示    用中转站没问题，方便且便宜
#   企业生产      应当直连官方 API，或用客户内网自部署的模型
#
# 产品里要把这个区别显式呈现给管理员（配置页面标注风险等级），
# 而不是让人以为所有 Provider 都等价。这属于「治理」的一部分，
# 见 docs/product-vision.md 支柱三。
# ---------------------------------------------------------------------------


# 演示环境的硬限流。公开 demo 会被脚本刷，而每次提问都是真金白银。
DEMO_RATE_LIMIT_PER_HOUR=20
