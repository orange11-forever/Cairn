node_modules/

# Python workspace：uv 本地环境、缓存和构建产物均可重新生成
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.pyright/
apps/api/dist/

# Web 构建产物：由 apps/web 的 pnpm build 生成，不进仓库
apps/web/dist/

# Web 验证产物：由 pnpm verify 重新生成
apps/web/screenshots/

# 工具目录
.superpowers/
docs/superpowers/

# 交接笔记：我和用户之间的工作笔记，不是项目文档。
# 里面有本机路径、学习进度、以及本地工具链的配置细节，不进公开仓库。
# 它的作用是让下一次会话能接上，那只需要本地存在。
.remember/

# 环境变量：含密钥，绝不进仓库。
# .env.example 是进仓库的——它告诉部署者有哪些东西可配。
.env
.env.local
.env.*.local
