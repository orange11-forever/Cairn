    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "js-yaml": "4.3.0",
    "jsdom": "30.0.1",
    "node-html-parser": "^9.0.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@cairn/sdk": "workspace:*",
